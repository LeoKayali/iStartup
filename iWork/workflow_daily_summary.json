{
  "name": "iWork - Daily Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [ 300, 300 ],
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Schedule Trigger (6 PM Daily)"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "[YOUR_BRIDGE_URL]/stats",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IWork-Token",
              "value": "[YOUR_BRIDGE_TOKEN]"
            }
          ]
        },
        "sendBody": false,
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 520, 300 ],
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Get Application Stats"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer [YOUR_RESEND_API_KEY]"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"onboarding@resend.dev\",\n  \"to\": [\"[YOUR_EMAIL]\"],\n  \"subject\": \"iWork: {{ $json.today_count }} applied, {{ $json.skipped_today }} skipped\",\n  \"html\": \"<p>Total applied (all-time): <strong>{{ $json.total_applied }}</strong></p><p>Submitted today: <strong>{{ $json.today_count }}</strong></p><ul>{{ $json.today_count === 0 ? '<li>Nothing submitted today.</li>' : $json.today_jobs.map(j => '<li>' + j + '</li>').join('') }}</ul><p>Skipped today: <strong>{{ $json.skipped_today }}</strong></p><ul>{{ Object.entries($json.skip_reasons || {}).map(e => '<li>' + e[1] + ' x ' + e[0] + '</li>').join('') || '<li>None</li>' }}</ul>\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 740, 300 ],
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Send Email via Resend"
    }
  ],
  "connections": {
    "Schedule Trigger (6 PM Daily)": {
      "main": [
        [
          { "node": "Get Application Stats", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Application Stats": {
      "main": [
        [
          { "node": "Send Email via Resend", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}
