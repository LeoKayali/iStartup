{
  "name": "iWork",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [ 240, 440 ],
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Daily 8 AM - Apply"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "[YOUR_BRIDGE_URL]/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-IWork-Token", "value": "[YOUR_BRIDGE_TOKEN]" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"keyword\": \"Electronics Automation, Controls Engineer, PLC\",\n  \"location\": \"San Francisco\",\n  \"limit\": 5\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 520, 300 ],
