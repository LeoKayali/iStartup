          "parameters": [
            { "name": "X-IWork-Token", "value": "[YOUR_BRIDGE_TOKEN]" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.url }}\",\n  \"jobtitle\": \"{{ $json.title }}\",\n  \"resume_name\": \"{{ $json.resume || 'Resume_Electronics.pdf' }}\"\n}",
        "options": {}
