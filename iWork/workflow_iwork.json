      "typeVersion": 1,
      "position": [ 780, 300 ],
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "Split Jobs (SF)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "[YOUR_BRIDGE_URL]/apply",
