          "parameters": [
            { "name": "X-IWork-Token", "value": "[YOUR_BRIDGE_TOKEN]" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.url }}\",\n  \"jobtitle\": \"{{ $json.title }}\",\n  \"resume_name\": \"{{ $json.resume || 'Resume_Electronics.pdf' }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 1040, 300 ],
      "id": "c1000000-0000-4000-8000-000000000004",
