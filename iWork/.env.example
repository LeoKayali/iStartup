# Copy to .env and fill in. This file is also read by systemd via
# EnvironmentFile, so use KEY=value with no `export`.
# Paths below assume an install at /opt/iwork -- adjust to yours.

# --- Paths -------------------------------------------------------------
# Python interpreter (use the venv one, not the system one)
PYTHON_PATH=/opt/iwork/venv/bin/python
# Directory holding search_jobs.py and apply_job.py
SCRIPTS_DIR=/opt/iwork
# Logs and the applied/skipped "memory bank"
LOG_DIR=/opt/iwork/logs
# Resume PDFs live on disk. They never change, so there is no reason to pull
# them from Google Drive per run and depend on an OAuth token that expires
# after 7 days when the consent screen is in Testing status.
RESUME_DIR=/opt/iwork/resumes

# --- Bridge auth -------------------------------------------------------
# This service runs subprocesses and listens on 0.0.0.0 so an n8n container
# can reach it. Generate one with: openssl rand -hex 32
# The same value goes in the X-IWork-Token header in both workflows.
BRIDGE_TOKEN=

# --- Applicant identity (never put these in the n8n workflow) ----------
APPLICANT_EMAIL=you@example.com
APPLICANT_FIRSTNAME=Jane
APPLICANT_LASTNAME=Doe
APPLICANT_PHONE="555 555 0100"
APPLICANT_LINKEDIN=linkedin.com/in/your-handle
# Password used when a job board forces account creation mid-application.
# Leave blank to skip password fields entirely.
IWORK_APPLY_PASSWORD=

# --- Search tuning -----------------------------------------------------
COUNTRY_INDEED=USA
RESULTS_WANTED=15
HOURS_OLD=168
# Cap applications per run so one run cannot burn the whole HOURS_OLD pool
# and then starve every later run.
MAX_PER_RUN=5
DESC_CHARS=3000

# Job boards match keywords against the entire posting, so a title filter is
# what keeps "Legal Assistant" out of an "Electronics Automation" search.
# Leave unset to use the defaults in search_jobs.py.
# MATCH_TITLE_ANY=electronic,automation,controls,plc,scada,embedded,hardware,pcb
# EXCLUDE_TITLE_ANY=legal,attorney,paralegal,nurse,driver,sales,recruiter

# --- Timeouts (seconds) ------------------------------------------------
SEARCH_TIMEOUT=300
APPLY_TIMEOUT=240
