{
  "name": "iWork - Autonomous Job Application",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [ 240, 440 ],
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "[YOUR_BRIDGE_URL]/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IWork-Token",
              "value": "[YOUR_BRIDGE_TOKEN]"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"keyword\": \"Electronics Automation, Controls Engineer, PLC\",\n  \"location\": \"San Francisco\",\n  \"limit\": 5\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 520, 300 ],
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Search Jobs (SF)"
    },
    {
      "parameters": {
        "fieldToSplitOut": "jobs",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [ 780, 300 ],
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Split Jobs (SF)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "[YOUR_BRIDGE_URL]/apply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IWork-Token",
              "value": "[YOUR_BRIDGE_TOKEN]"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.url }}\",\n  \"jobtitle\": \"{{ $json.title }}\",\n  \"resume_name\": \"{{ $json.resume || 'Resume_Electronics.pdf' }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 1040, 300 ],
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Apply to Job (SF)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "[YOUR_BRIDGE_URL]/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IWork-Token",
              "value": "[YOUR_BRIDGE_TOKEN]"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"keyword\": \"Electronics Automation, Controls Engineer, PLC\",\n  \"location\": \"Remote\",\n  \"limit\": 5\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 520, 580 ],
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Search Jobs (Remote)"
    },
    {
      "parameters": {
        "fieldToSplitOut": "jobs",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [ 780, 580 ],
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Split Jobs (Remote)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "[YOUR_BRIDGE_URL]/apply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IWork-Token",
              "value": "[YOUR_BRIDGE_TOKEN]"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.url }}\",\n  \"jobtitle\": \"{{ $json.title }}\",\n  \"resume_name\": \"{{ $json.resume || 'Resume_Electronics.pdf' }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 1040, 580 ],
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Apply to Job (Remote)"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          { "node": "Search Jobs (SF)", "type": "main", "index": 0 },
          { "node": "Search Jobs (Remote)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Search Jobs (SF)": {
      "main": [
        [
          { "node": "Split Jobs (SF)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Split Jobs (SF)": {
      "main": [
        [
          { "node": "Apply to Job (SF)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Search Jobs (Remote)": {
      "main": [
        [
          { "node": "Split Jobs (Remote)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Split Jobs (Remote)": {
      "main": [
        [
          { "node": "Apply to Job (Remote)", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Los_Angeles"
  }
}
