{
  "name": "iWork - Autonomous Job Application",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [ 240, 400 ],
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "[YOUR_BRIDGE_URL]/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IWork-Token",
              "value": "[YOUR_BRIDGE_TOKEN]"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"keyword\": \"Electronics Automation, Controls Engineer, PLC\",\n  \"location\": \"San Francisco\",\n  \"limit\": 5\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 480, 240 ],
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Search Jobs (SF)"
    },
    {
      "parameters": {
        "fieldToSplitOut": "jobs",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [ 700, 240 ],
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Split Jobs (SF)"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.description }}",
        "options": {
          "systemMessage": "You classify job descriptions to select a resume.\n\nIf the description mentions PLC, Automation, Control Systems, or SCADA, respond with exactly: Resume_Control.pdf\nIf it mentions Hardware, Circuit, PCB, or Embedded, respond with exactly: Resume_Electronics.pdf\nIf unsure, respond with exactly: Resume_Electronics.pdf\n\nOutput only the filename. No explanation, no punctuation, no other text."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.4,
      "position": [ 920, 240 ],
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Pick Resume (SF)"
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [ 920, 420 ],
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Gemini (SF)",
      "credentials": {
        "googlePalmApi": {
          "id": "[YOUR_CREDENTIALS_ID]",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [ 1160, 240 ],
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Job + Resume (SF)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "[YOUR_BRIDGE_URL]/apply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IWork-Token",
              "value": "[YOUR_BRIDGE_TOKEN]"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.url }}\",\n  \"jobtitle\": \"{{ $json.title }}\",\n  \"resume_name\": \"{{ $json.output && $json.output.includes('Resume_Control') ? 'Resume_Control.pdf' : 'Resume_Electronics.pdf' }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 1400, 240 ],
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Apply to Job (SF)"
    },
